<form action='@Url.Action("Index", "Home")' method="post"> 
<input type="submit" name="submit" value="elegir">
</form>

<form action='@Url.Action("borrarCliente", "Home")' method="post"> 

@foreach(var client in ViewBag.clients){
    <div>
        <p>cliente: @client.nombre @client.apellido</p>
    </div>
    <button type="submit" name="idCliente" value=@client.idCliente>BORRAR</button>
}

</form>