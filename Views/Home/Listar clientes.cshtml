<link rel="stylesheet" href="~/css/estilo.css" asp-append-version="true" />
<section>
@foreach(var client in ViewBag.clients){
    <div>
        <p>@client.nombre @client.apellido</p>
        <p>dni: @client.DNI</p>
        <p>fecha de nacimiento: @client.FechaNacimiento</p>
        <p>contacto: @client.Email</p>
    </div>
}
</section>
